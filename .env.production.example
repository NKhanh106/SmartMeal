# ═══════════════════════════════════════════════════════════════════════════════
# SMART MEAL — PRODUCTION ENV TEMPLATE
# Copy this file to .env.production, fill in all CHANGE_ME values
# DO NOT commit .env.production to git
#
# Run with: docker compose -f docker-compose.production.yml up --build
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
VERSION=1.0.0

# ── Security — MUST change ────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_at_least_32_random_characters_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database (local docker postgres) ────────────────────────────────────────────
POSTGRES_DB=smartmeal
POSTGRES_USER=smartmeal
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# ── AI Providers ──────────────────────────────────────────────────────────────
AI_CHAT_PROVIDER=groq
AI_PLANNER_PROVIDER=groq
AI_MEAL_PROVIDER=gemini
GROQ_API_KEY=CHANGE_ME_GROQ_KEY
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=CHANGE_ME_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
USDA_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_BYTES=5242880
IMAGE_PUBLIC_BASE_URL=/uploads
IMAGE_RETENTION_DAYS_MEAL=7
IMAGE_RETENTION_DAYS_TEMPORARY=1
IMAGE_RETENTION_DAYS_PROGRESS=

# ── Cache TTL ─────────────────────────────────────────────────────────────────
AI_CACHE_TTL_SECONDS=3600
FOOD_RECOGNITION_CACHE_TTL=86400
DAILY_PLAN_CACHE_TTL=43200

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=Smart Meal
