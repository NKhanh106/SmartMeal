# ═══════════════════════════════════════════════════════════════════════════════
# SMART MEAL API — PRODUCTION ENV TEMPLATE
# Copy file này thành .env.production và điền giá trị thật
# KHÔNG commit file .env.production lên git
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
VERSION=1.0.0

# ── Security — BẮT BUỘC thay đổi, tối thiểu 32 ký tự ────────────────────────
# Sinh key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_USE_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432
POSTGRES_DB=smartmeal_prod
POSTGRES_USER=smartmeal_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379/0
REDIS_MAX_CONNECTIONS=20

# ── AI Providers ───────────────────────────────────────────────────────────────
AI_CHAT_PROVIDER=groq
AI_PLANNER_PROVIDER=groq
AI_MEAL_PROVIDER=gemini

GROQ_API_KEY=gsk_CHANGE_ME
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GEMINI_API_KEY=AIza_CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash

USDA_API_KEY=

# ── CORS — liệt kê domain thật, KHÔNG dùng * ──────────────────────────────────
# Ví dụ: ["https://yourdomain.com","https://www.yourdomain.com"]
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_BYTES=5242880
IMAGE_PUBLIC_BASE_URL=/uploads
IMAGE_RETENTION_DAYS_MEAL=7
IMAGE_RETENTION_DAYS_TEMPORARY=1
IMAGE_RETENTION_DAYS_PROGRESS=

# ── Cache TTL ──────────────────────────────────────────────────────────────────
AI_CACHE_TTL_SECONDS=3600
FOOD_RECOGNITION_CACHE_TTL=86400
DAILY_PLAN_CACHE_TTL=43200
