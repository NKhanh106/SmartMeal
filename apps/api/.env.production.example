# ═══════════════════════════════════════════════════════════════════════════════
# SMART MEAL API — PRODUCTION ENV TEMPLATE
# Copy this file to .env.production and fill in real values
# DO NOT commit .env.production to git
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
VERSION=1.0.0

# ── Security — MUST change, minimum 32 characters ─────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_USE_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database (Supabase) ───────────────────────────────────────────────────────
#
# App runtime (port 6543 — pooled via PgBouncer):
#   postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?sslmode=require
#
# Migrations (port 5432 — direct, no PgBouncer):
#   MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# Get your connection string from:
#   Supabase Dashboard → Settings → Database → Connection Pooling
#
# NOTE: If your password contains special characters (@, #, $, %, &, +, /, :, =, ?)
# you MUST URL-encode them:
#   @ → %40, # → %23, $ → %24, % → %25, & → %26, + → %2B, / → %2F, : → %3A, = → %3D, ? → %3F
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?sslmode=require

# Separate sync URL for Alembic migrations (uses direct connection, port 5432)
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# ── AI Providers ───────────────────────────────────────────────────────────────
AI_CHAT_PROVIDER=groq
AI_PLANNER_PROVIDER=groq
AI_MEAL_PROVIDER=gemini

# Multiple keys separated by comma - will rotate on rate limit
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GEMINI_API_KEY=AIza_CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash

USDA_API_KEY=

# ── Web Research (Tavily) ───────────────────────────────────────────────────
# Get your key at: https://tavily.com (free tier: 1000 searches/day)
TAVILY_API_KEY=
TAVILY_ENABLED=true

# ── CORS — list real domains, NOT wildcard ─────────────────────────────────────
# Examples: ["https://yourdomain.com","https://www.yourdomain.com"]
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_BYTES=5242880
IMAGE_PUBLIC_BASE_URL=/uploads
IMAGE_RETENTION_DAYS_MEAL=7
IMAGE_RETENTION_DAYS_TEMPORARY=1
IMAGE_RETENTION_DAYS_PROGRESS=

# ── Cache TTL ─────────────────────────────────────────────────────────────────
AI_CACHE_TTL_SECONDS=3600
FOOD_RECOGNITION_CACHE_TTL=86400
DAILY_PLAN_CACHE_TTL=43200
