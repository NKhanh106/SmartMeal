# SMART MEAL FRONTEND — DEVELOPMENT ENV TEMPLATE
# Copy file này thành .env.local (cho dev) hoặc .env.production (cho prod)
# KHÔNG commit các file .env thực tế lên git
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API URL (phải bắt đầu bằng http:// hoặc https://)
NEXT_PUBLIC_API_BASE_URL=http://api:8000

# Tên hiển thị của ứng dụng
NEXT_PUBLIC_APP_NAME=Smart Meal
