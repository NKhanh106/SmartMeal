# ═══════════════════════════════════════════════════════════════════════════════
# SMART MEAL FRONTEND — PRODUCTION ENV TEMPLATE
# Copy this file to .env.production and fill in real values
# DO NOT commit .env.production to git
# ═══════════════════════════════════════════════════════════════════════════════

# ── API URL — MUST be a public URL reachable from the browser ────────────────
#
# If API is on the same domain (recommended for production):
#   NEXT_PUBLIC_API_URL=https://yourdomain.com
#
# If API is on a separate subdomain:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#
# IMPORTANT: This must NOT be an internal Docker hostname (e.g. http://api:8000).
# The browser cannot reach Docker internal hostnames — it makes requests from
# the user's device, not from inside the Docker network.
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ── App Info ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Smart Meal
